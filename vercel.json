{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/ai/(.*)",
      "destination": "/api/ai.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
